{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Serve PharmConsilium (local)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/serve.ps1"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "pharmconsilium-serve",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "PharmConsilium local server",
          "endsPattern": "http://127\\.0\\.0\\.1:3000/"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false
      }
    }
  ]
}
