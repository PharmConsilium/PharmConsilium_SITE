# Корень сайта: скопируйте корневой .htaccess (301 + SPA) или вставьте deploy/redirects-old-site.htaccess выше этого блока.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # HTTPS (если терминация SSL на Apache)
  # RewriteCond %{HTTPS} off
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Существующие файлы и каталоги — как есть
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA: все остальные пути → index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Кеш статики (опционально)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>
