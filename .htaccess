# pharmconsilium.com — legacy 301 + SPA
# Правило: только mod_rewrite + %{THE_REQUEST}, без mod_alias Redirect (риск циклов с index.php).

DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # SEO-spam URLs from hack (?p=12345) — 410 Gone (Google drops from index faster than 404)
  RewriteCond %{QUERY_STRING} (^|&)p= [NC]
  RewriteRule ^ - [G,L]

  # --- Старый PHP-сайт (явный запрос в браузере) ---
  RewriteCond %{THE_REQUEST} \s/+index\.php[\s?] [NC]
  RewriteRule ^index\.php$ / [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+contact\.php[\s?] [NC]
  RewriteRule ^contact\.php$ /team [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+team/contacts/?[\s?] [NC]
  RewriteRule ^team/contacts/?$ /team [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+politics\.php[\s?] [NC]
  RewriteRule ^politics\.php$ /privacy [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+trainings\.php[\s?] [NC]
  RewriteRule ^trainings\.php$ /hcp/education [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+outsourcing\.php[\s?] [NC]
  RewriteRule ^outsourcing\.php$ /sales [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+create-stm\.php[\s?] [NC]
  RewriteRule ^create-stm\.php$ /content [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+tools\.php[\s?] [NC]
  RewriteRule ^tools\.php$ /marketing [R=301,L]

  # --- /tool/... ---
  RewriteCond %{THE_REQUEST} \s/+tool/DigitalMedRep-promotion-in-RX[\s?] [NC]
  RewriteRule ^tool/DigitalMedRep-promotion-in-RX$ /sales/digital-rep [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+tool/room-training-pharmacists-doctor[\s?] [NC]
  RewriteRule ^tool/room-training-pharmacists-doctor$ /hcp/education [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+tool/medpred-videovizit-digital-to-face-d2f[\s?] [NC]
  RewriteRule ^tool/medpred-videovizit-digital-to-face-d2f$ /sales/digital-rep [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+tool/robotcoach-pharmacy-gametraining-simulator-obuchayushchiy-igrovoy-simulyator-dlya-aptek[\s?] [NC]
  RewriteRule ^tool/robotcoach-pharmacy-gametraining-simulator-obuchayushchiy-igrovoy-simulyator-dlya-aptek$ /content/gamification [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+tool/Marketingovye-issledovaniya-farmacevticheskogo-rynka-Belarus[\s?] [NC]
  RewriteRule ^tool/Marketingovye-issledovaniya-farmacevticheskogo-rynka-Belarus$ /sales/analytics [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+tool/PharmInfo[\s?] [NC]
  RewriteRule ^tool/PharmInfo$ /directory [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+tool/quiz-simulator-game-tests-online[\s?] [NC]
  RewriteRule ^tool/quiz-simulator-game-tests-online$ /content/gamification [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+tool/razrabotka-Telegram-bot-GPT-dlya-prodvizheniya[\s?] [NC]
  RewriteRule ^tool/razrabotka-Telegram-bot-GPT-dlya-prodvizheniya$ /marketing/chatbot [R=301,L]

  # --- /outsourcings/... ---
  RewriteCond %{THE_REQUEST} \s/+outsourcings/med-pharm-content-outsourcing[\s?] [NC]
  RewriteRule ^outsourcings/med-pharm-content-outsourcing$ /content/medical [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+outsourcings/autsorsing-meditsinskikh-predstaviteley-belarus[\s?] [NC]
  RewriteRule ^outsourcings/autsorsing-meditsinskikh-predstaviteley-belarus$ /sales/digital-rep [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+outsourcings/Digitalrep-bigfarma-rx-marleting-promotia-lekarstv[\s?] [NC]
  RewriteRule ^outsourcings/Digitalrep-bigfarma-rx-marleting-promotia-lekarstv$ /sales/digital-rep [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+outsourcings/launch-outsourcing-of-a-pharmaceutical-brand-Belarus[\s?] [NC]
  RewriteRule ^outsourcings/launch-outsourcing-of-a-pharmaceutical-brand-Belarus$ /sales/launch [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+outsourcings/meditcinskiy-kopirayting-i-medkontent[\s?] [NC]
  RewriteRule ^outsourcings/meditcinskiy-kopirayting-i-medkontent$ /content/medical [R=301,L]

  # --- /training/... ---
  RewriteCond %{THE_REQUEST} \s/+training/struktura-vizita-meditsiskogo-predstavitelya-k-vrachu[\s?] [NC]
  RewriteRule ^training/struktura-vizita-meditsiskogo-predstavitelya-k-vrachu$ /hcp/education [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+training/etapy-vizita-meditsinskogo-predstavitelya-v-apteku[\s?] [NC]
  RewriteRule ^training/etapy-vizita-meditsinskogo-predstavitelya-v-apteku$ /hcp/education [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+training/medrep-vizit-ogranichennyy-po-vremeni[\s?] [NC]
  RewriteRule ^training/medrep-vizit-ogranichennyy-po-vremeni$ /sales/digital-rep [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+training/presentation-skills[\s?] [NC]
  RewriteRule ^training/presentation-skills$ /hcp/education [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+training/online-trening-medpredov[\s?] [NC]
  RewriteRule ^training/online-trening-medpredov$ /hcp/education [R=301,L]

  # --- /stm/... ---
  RewriteCond %{THE_REQUEST} \s/+stm/promo-reels-tik-tok-shorts[\s?] [NC]
  RewriteRule ^stm/promo-reels-tik-tok-shorts$ /content/video [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+stm/digital-avatar[\s?] [NC]
  RewriteRule ^stm/digital-avatar$ /content/video [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+stm/clinic-detective[\s?] [NC]
  RewriteRule ^stm/clinic-detective$ /content/gamification [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+stm/digital-promo-content[\s?] [NC]
  RewriteRule ^stm/digital-promo-content$ /content/presentations [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+stm/create-brand-book-drug[\s?] [NC]
  RewriteRule ^stm/create-brand-book-drug$ /content/presentations [R=301,L]

  # --- SPA (после legacy; не трогать существующие файлы и каталоги) ---
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>
